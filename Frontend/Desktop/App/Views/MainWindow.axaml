<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:App.ViewModels"
        x:Class="App.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Width="1100"
        Height="760"
        MinWidth="900"
        MinHeight="600"
        Background="#10151D"
        Title="Nodren">
    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>

    <Grid RowDefinitions="Auto,*" Margin="24">
        <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,18">
            <StackPanel>
                <TextBlock FontSize="28" FontWeight="SemiBold" Foreground="#F4F7FB" Text="Nodren" />
                <TextBlock Margin="0,4,0,0" Foreground="#9AA7B8" Text="Native workload cluster dashboard" />
            </StackPanel>
            <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                <TextBlock HorizontalAlignment="Right" FontSize="15" FontWeight="SemiBold" Text="{Binding ControllerStatus}" />
                <TextBlock HorizontalAlignment="Right" Margin="0,4,0,0" Foreground="#9AA7B8" Text="{Binding LastUpdated}" />
            </StackPanel>
        </Grid>

        <TabControl Grid.Row="1">
            <TabItem Header="Dashboard">
                <ScrollViewer Padding="0,18,0,0">
                    <StackPanel Spacing="16">
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
                            <Border Padding="18" Background="#192331" CornerRadius="8">
                                <StackPanel>
                                    <TextBlock Foreground="#9AA7B8" Text="Workers" />
                                    <TextBlock Margin="0,8,0,0" FontSize="24" Text="{Binding Workers.Count}" />
                                    <TextBlock Margin="0,8,0,0" Foreground="#B5C2D2" Text="{Binding WorkerSummary}" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="1" Padding="18" Background="#192331" CornerRadius="8">
                                <StackPanel>
                                    <TextBlock Foreground="#9AA7B8" Text="Jobs" />
                                    <TextBlock Margin="0,8,0,0" FontSize="24" Text="{Binding Jobs.Count}" />
                                    <TextBlock Margin="0,8,0,0" Foreground="#B5C2D2" Text="{Binding JobSummary}" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </Grid>
                        <Border Padding="18" Background="#192331" CornerRadius="8">
                            <StackPanel Spacing="8">
                                <TextBlock FontSize="18" FontWeight="SemiBold" Text="Controller" />
                                <TextBlock Foreground="#B5C2D2" Text="{Binding ControllerUrl}" />
                                <TextBlock Foreground="#F2B880" Text="{Binding ErrorMessage}" TextWrapping="Wrap" />
                                <Button HorizontalAlignment="Left" Padding="18,8" Command="{Binding RefreshCommand}" Content="Refresh now" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Workers">
                <Grid ColumnDefinitions="2*,3*" ColumnSpacing="16" Margin="0,18,0,0">
                    <ListBox ItemsSource="{Binding Workers}" SelectedItem="{Binding SelectedWorker}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="6" Spacing="4">
                                    <TextBlock FontWeight="SemiBold" Text="{Binding Info.Id}" />
                                    <TextBlock Foreground="#B5C2D2" Text="{Binding State}" />
                                    <TextBlock Foreground="#9AA7B8" Text="{Binding Info.Os} · {Binding Info.Arch}" />
                                    <TextBlock Foreground="#9AA7B8" Text="CPU {Binding Info.CpuCores} · RAM {Binding Info.RamGb} GB" />
                                    <TextBlock Foreground="#9AA7B8" Text="Load {Binding Telemetry.CpuUtilizationPercent, StringFormat={}{0:0.#}%} · active {Binding Telemetry.ActiveTasks}" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <Border Grid.Column="1" Padding="18" Background="#192331" CornerRadius="8">
                        <ScrollViewer>
                            <StackPanel Spacing="8">
                                <TextBlock FontSize="18" FontWeight="SemiBold" Text="Worker details" />
                                <TextBlock Text="{Binding SelectedWorker.Info.Id}" />
                                <TextBlock Foreground="#B5C2D2" Text="{Binding SelectedWorker.State}" />
                                <TextBlock Foreground="#9AA7B8" Text="{Binding SelectedWorker.Info.Hostname}" />
                                <TextBlock Foreground="#9AA7B8" Text="CPU model: {Binding SelectedWorker.Info.CpuModel}" TextWrapping="Wrap" />
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <TextBlock Foreground="#9AA7B8" Text="CPU allocated: " />
                                    <TextBlock Foreground="#9AA7B8" Text="{Binding SelectedWorker.AllocatedCpuCores}" />
                                    <TextBlock Foreground="#9AA7B8" Text=" / " />
                                    <TextBlock Foreground="#9AA7B8" Text="{Binding SelectedWorker.Info.CpuCores}" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <TextBlock Foreground="#9AA7B8" Text="RAM allocated: " />
                                    <TextBlock Foreground="#9AA7B8" Text="{Binding SelectedWorker.AllocatedRamGb}" />
                                    <TextBlock Foreground="#9AA7B8" Text=" / " />
                                    <TextBlock Foreground="#9AA7B8" Text="{Binding SelectedWorker.Info.RamGb}" />
                                    <TextBlock Foreground="#9AA7B8" Text=" GB" />
                                </StackPanel>
                                <TextBlock Foreground="#9AA7B8" Text="{Binding SelectedWorker.AssignedJobs.Count}" />
                                <TextBlock Foreground="#9AA7B8" Text="{Binding SelectedWorker.LastHeartbeat}" TextWrapping="Wrap" />
                                <TextBlock Foreground="#9AA7B8" Text="Telemetry CPU: {Binding SelectedWorker.Telemetry.CpuUtilizationPercent, StringFormat={}{0:0.#}%} · RAM available: {Binding SelectedWorker.Telemetry.MemoryAvailableGb} GB" TextWrapping="Wrap" />
                                <TextBlock Foreground="#9AA7B8" Text="Scheduler capacity: {Binding SelectedWorker.EffectiveCapacity, StringFormat={}{0:0.##}} · performance factor: {Binding SelectedWorker.PerformanceFactor, StringFormat={}{0:0.##}}" TextWrapping="Wrap" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button Command="{Binding PingWorkerCommand}" Content="Ping" />
                                    <Button Command="{Binding PauseWorkerCommand}" Content="Pause" />
                                    <Button Command="{Binding ResumeWorkerCommand}" Content="Resume" />
                                    <Button Command="{Binding RemoveWorkerCommand}" Content="Remove" />
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="Jobs">
                <Grid ColumnDefinitions="2*,3*" ColumnSpacing="16" Margin="0,18,0,0">
                    <Border Padding="10" Background="#192331" CornerRadius="8">
                        <ListBox ItemsSource="{Binding Jobs}" SelectedItem="{Binding SelectedJob}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="6" Spacing="3">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <TextBlock FontWeight="SemiBold" Text="{Binding Command}" />
                                            <TextBlock FontWeight="SemiBold" Text="{Binding Status}" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <TextBlock Foreground="#9AA7B8" Text="{Binding Id}" />
                                            <TextBlock Foreground="#9AA7B8" Text="worker" />
                                            <TextBlock Foreground="#9AA7B8" Text="{Binding NodeId}" />
                                        </StackPanel>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>
                    <Border Grid.Column="1" Padding="18" Background="#192331" CornerRadius="8">
                        <ScrollViewer>
                            <StackPanel Spacing="10">
                                <TextBlock Foreground="#D7E0EB" Text="{Binding JobDetails}" TextWrapping="Wrap" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button Command="{Binding CancelJobCommand}" Content="Cancel" />
                                    <Button Command="{Binding PauseJobCommand}" Content="Pause" />
                                    <Button Command="{Binding ResumeJobCommand}" Content="Resume" />
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="Run">
                <ScrollViewer Padding="0,18,0,0">
                    <StackPanel MaxWidth="720" Spacing="12">
                        <TextBlock FontSize="20" FontWeight="SemiBold" Text="Run task" />
                        <TextBlock Foreground="#9AA7B8" Text="Submit a native workload or an OS process through the Controller HTTP API. Process tasks run on a trusted worker with bounded capture and timeout enforcement." TextWrapping="Wrap" />
                        <TextBlock Margin="0,8,0,0" Text="Task type" />
                        <ComboBox ItemsSource="{Binding TaskTypes}" SelectedItem="{Binding SelectedTaskType}" />
                        <TextBlock Margin="0,8,0,0" Text="Workload" />
                        <ComboBox ItemsSource="{Binding Workloads}" SelectedItem="{Binding SelectedWorkload}" />
                        <TextBlock Text="Executable or command" />
                        <TextBox Text="{Binding Executable}" PlaceholderText="/usr/bin/echo or C:\\Windows\\System32\\cmd.exe" />
                        <TextBlock Text="Script runtime" />
                        <TextBox Text="{Binding ScriptRuntime}" PlaceholderText="python" />
                        <TextBlock Text="Script path" />
                        <TextBox Text="{Binding ScriptPath}" PlaceholderText="script.py" />
                        <TextBlock Text="Process/script arguments" />
                        <TextBox Text="{Binding GeneralArguments}" PlaceholderText="hello world" />
                        <TextBlock Margin="0,8,0,0" Text="Work distribution" />
                        <StackPanel Orientation="Horizontal" Spacing="16">
                            <RadioButton GroupName="DistributionMode" Content="Automatic" IsChecked="{Binding IsAutomaticDistribution}" />
                            <RadioButton GroupName="DistributionMode" Content="Manual" IsChecked="{Binding IsManualDistribution}" />
                        </StackPanel>
                        <TextBlock Foreground="#9AA7B8" Text="{Binding DistributionSummary}" TextWrapping="Wrap" />
                        <CheckBox Content="Advanced Distribution" IsChecked="{Binding IsAdvancedDistributionOpen}" />
                        <Border IsVisible="{Binding IsAdvancedDistributionOpen}" Padding="12" Background="#192331" CornerRadius="8">
                            <StackPanel Spacing="8">
                                <TextBlock FontWeight="SemiBold" Text="Manual allocation" />
                                <TextBlock Foreground="#9AA7B8" Text="Enter worker-id=percent entries separated by commas. The total must be 100%." TextWrapping="Wrap" />
                                <TextBox Text="{Binding ManualAllocationText}" PlaceholderText="worker-a=60,worker-b=40" />
                                <TextBlock Foreground="#9AA7B8" Text="Manual values are used only when Manual is selected." TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                        <TextBlock Text="Arguments for sum / xor" />
                        <TextBox Text="{Binding Arguments}" PlaceholderText="1 2 3 4 5" />
                        <TextBlock Text="Left vector for dot_product" />
                        <TextBox Text="{Binding LeftVector}" PlaceholderText="1,2,3" />
                        <TextBlock Text="Right vector for dot_product" />
                        <TextBox Text="{Binding RightVector}" PlaceholderText="4,5,6" />
                        <Button HorizontalAlignment="Left" Padding="22,10" Command="{Binding RunWorkloadCommand}" Content="Submit workload" />
                        <Border Padding="14" Background="#192331" CornerRadius="8">
                            <StackPanel Spacing="6">
                                <TextBlock Text="{Binding RunStatus}" TextWrapping="Wrap" />
                                <TextBlock Foreground="#9FE3B1" Text="{Binding RunResult}" TextWrapping="Wrap" />
                                <TextBlock Foreground="#F2B880" Text="{Binding ErrorMessage}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Settings">
                <Border Padding="0,18,0,0">
                    <StackPanel MaxWidth="720" Spacing="12">
                    <TextBlock FontSize="20" FontWeight="SemiBold" Text="Settings" />
                    <TextBlock Foreground="#9AA7B8" Text="Configure the Controller HTTP endpoint. The UI does not start or stop backend processes." TextWrapping="Wrap" />
                    <TextBlock Margin="0,8,0,0" Text="Controller URL" />
                    <TextBox Text="{Binding ControllerUrl}" PlaceholderText="http://127.0.0.1:8080" />
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Button Padding="18,8" Command="{Binding TestConnectionCommand}" Content="Save and test" />
                        <Button Padding="18,8" Command="{Binding SaveSettingsCommand}" Content="Save" />
                    </StackPanel>
                    <TextBlock Foreground="#F2B880" Text="{Binding ErrorMessage}" TextWrapping="Wrap" />
                    <TextBlock Margin="0,22,0,0" Foreground="#9AA7B8" Text="Nodren UI 0.2.0" />
                    </StackPanel>
                </Border>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
